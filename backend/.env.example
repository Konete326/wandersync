# ==============================================================================
# WanderSync - Master Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.nsgxas8.mongodb.net/wandorsync?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# AI Provider Keys (Dual Engine: OpenAI GPT-4o with Gemini 3.7 Fallback)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Free Tier available at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (For GPT-4 / GPT-4o: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Cloudinary Cloud Storage (Free 25GB at: https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# External Travel APIs (100% Free Tiers - Paste keys here to activate live data)
# ------------------------------------------------------------------------------
# 1. Geoapify Places API (3,000 Free Requests/day, No Credit Card needed)
# Signup: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# 2. RapidAPI Key (For Booking.com & Flight Radar Free Basic Tiers)
# Signup: https://rapidapi.com/
RAPIDAPI_KEY=

# 3. Ticketmaster Discovery API (5,000 Free Calls/day for live city events & concerts)
# Signup: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# 4. Amadeus Travel Innovation API (2,000 Free Transactions/month for flights & hotels)
# Signup: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# 5. Google Places API ($200 Monthly Free Google Cloud Credit)
# Signup: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# 6. OpenWeatherMap API (1,000 Free Calls/day)
# Signup: https://openweathermap.org/api
OPENWEATHER_API_KEY=
